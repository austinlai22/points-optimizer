# Copy to .env.local for local work, and set the real values in Vercel
# (Project → Settings → Environment Variables). Never commit real values.

# --- Storage: anonymous usage counts and opt-in price reports ---
# Added automatically when you connect Upstash Redis from the Vercel Marketplace.
# Also put them in .env.local to run `npm run stats` and `npm run export-reports`.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Plaid sandbox (demo only; there is no production mode) ---
ENABLE_PLAID_SANDBOX=false
PLAID_CLIENT_ID=
PLAID_SECRET=

# --- AI features (optional): "Ask PointCompass" and reading trips by Gemini ---
# A free key from https://aistudio.google.com/apikey. Without it the assistant
# stays hidden, and "Describe your trip" uses the browser's own AI or a plain
# text reader. On the free tier Google may use what's sent to improve its
# products; PointCompass never sends balances or cash amounts.
GEMINI_API_KEY=
# A Gemini model with a free tier. Defaults to gemini-3.5-flash-lite.
GEMINI_MODEL=
# Calls allowed per day across everyone, to stay inside the free quota.
AI_DAILY_LIMIT=400
