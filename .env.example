# Copy to .env.local for local work, and set the real values in Vercel
# (Project → Settings → Environment Variables). Never commit real values.

# --- WhatsApp pilot (Meta WhatsApp Cloud API, test number) ---
# Use a system-user token (Business Settings → Users → System users), which
# doesn't expire; the temporary token on the API Setup page lasts about a day.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any long random string. You type the same one into Meta's webhook settings.
WHATSAPP_VERIFY_TOKEN=
# App Dashboard → App settings → Basic → App secret. Verifies Meta's signatures.
WHATSAPP_APP_SECRET=
# Optional; defaults to v26.0.
WHATSAPP_GRAPH_VERSION=

# --- Storage: WhatsApp conversations and pilot event counts ---
# Added automatically when you connect Upstash Redis from the Vercel Marketplace.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Bearer token for GET /api/event, which returns the counts. 16+ characters.
STATS_TOKEN=

# --- Plaid sandbox (demo only; there is no production mode) ---
ENABLE_PLAID_SANDBOX=false
PLAID_CLIENT_ID=
PLAID_SECRET=

# --- Site ---
PUBLIC_APP_URL=https://pointcompass.vercel.app
# Shown on the landing page as "Text it on WhatsApp" once set, e.g. 15551234567.
VITE_WHATSAPP_NUMBER=
