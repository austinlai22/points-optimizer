# Copy to .env.local for local work, and set the real values in Vercel
# (Project → Settings → Environment Variables). Never commit real values.

# --- Storage: anonymous usage counts and opt-in price reports ---
# Added automatically when you connect Upstash Redis from the Vercel Marketplace.
# Also put them in .env.local to run `npm run stats` and `npm run export-reports`.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Plaid sandbox (demo only; there is no production mode) ---
ENABLE_PLAID_SANDBOX=false
PLAID_CLIENT_ID=
PLAID_SECRET=
