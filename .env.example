# Copy to .env.local for local work, and set the real values in Vercel
# (Project → Settings → Environment Variables). Never commit real values.

# --- Storage: anonymous usage counts ---
# Added automatically when you connect Upstash Redis from the Vercel Marketplace.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Bearer token for GET /api/event, which returns the counts. 16+ characters.
STATS_TOKEN=

# --- Plaid sandbox (demo only; there is no production mode) ---
ENABLE_PLAID_SANDBOX=false
PLAID_CLIENT_ID=
PLAID_SECRET=
