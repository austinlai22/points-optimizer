# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vercel

# Secrets: only .env.example (no values) is committed
.env
.env.*
!.env.example

# Experiment kit: the generated answer key and filled-in results stay local,
# so a browsing assistant can't find the answers in the public repo.
experiment/questions.csv
experiment/results*.csv
!experiment/results-template.csv

# Your own price entries for npm run import-reports stay local.
price-reports/*.csv
!price-reports/template.csv
